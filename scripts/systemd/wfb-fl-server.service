[Unit]
Description=WFB-ng FL server role
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
EnvironmentFile=/etc/default/wfb-fl-server
ExecStart=/usr/bin/wfb-fl-server --config=/etc/wfb-ng/fl-server.json --algorithm=${ALGORITHM} --algorithm-config=${ALGORITHM_CONFIG}
KillMode=control-group
TimeoutStopSec=15s
Restart=on-failure
RestartSec=5s
StandardError=inherit

[Install]
WantedBy=multi-user.target
